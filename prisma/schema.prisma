// Hamburgueria Prime — Prisma schema
// Banco de dados: SQLite (arquivo local, zero configuração).
// Para produção, troque o provider para "postgresql" e aponte DATABASE_URL
// para sua instância (Neon, Supabase, RDS, etc). O restante do schema
// funciona sem alterações em ambos os provedores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Autenticação / Usuários
// ------------------------------------------------------------------

enum Role {
  CLIENTE
  ADMIN
  ENTREGADOR
}

enum RestaurantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Restaurant {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  customDomain          String?          @unique
  logoUrl               String?
  primaryColor          String           @default("#ed1c24")
  description           String?
  phone                 String?
  whatsapp              String?
  email                 String?
  cnpj                  String?
  address               String?
  businessHours         String?
  deliveryFee           Float            @default(0)
  freeDeliveryThreshold Float?
  pixKey                String?
  status                RestaurantStatus @default(TRIALING)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  users           User[]
  categories      Category[]
  addons          Addon[]
  products        Product[]
  coupons         Coupon[]
  orders          Order[]
  contactMessages ContactMessage[]
  siteVisits      SiteVisit[]
  subscription    Subscription?
}

model Plan {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  description        String?
  monthlyPrice       Float
  yearlyPrice        Float?
  launchMonthlyPrice Float?
  launchSlots        Int?
  features           String[]       @default([])
  active             Boolean        @default(true)
  maxProducts        Int?
  maxUsers           Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  restaurantId           String             @unique
  planId                 String
  status                 SubscriptionStatus @default(PENDING)
  billingCycle           BillingCycle       @default(MONTHLY)
  provider               String             @default("MERCADO_PAGO")
  providerSubscriptionId String?            @unique
  checkoutUrl            String?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  restaurant Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan                  @relation(fields: [planId], references: [id])
  payments   SubscriptionPayment[]
}

model SubscriptionPayment {
  id                String       @id @default(cuid())
  subscriptionId    String
  providerPaymentId String?      @unique
  status            String
  amount            Float
  dueDate           DateTime?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  phone           String?
  cpf             String?
  image           String?
  role            Role      @default(CLIENTE)
  restaurantId    String?
  isPlatformAdmin Boolean   @default(false)
  blocked         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastAccess      DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  addresses   Address[]
  cards       Card[]
  orders      Order[]
  favorites   Favorite[]
  reviews     Review[]
  coupons     CouponRedemption[]
  resetTokens PasswordResetToken[]
  deliveries  Order[]              @relation("EntregadorOrders")
  restaurant  Restaurant?          @relation(fields: [restaurantId], references: [id])

  @@index([email])
  @@index([restaurantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String   @default("Casa")
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  OUTRO
}

model Card {
  id         String    @id @default(cuid())
  userId     String
  brand      CardBrand @default(OUTRO)
  holderName String
  last4      String
  expMonth   Int
  expYear    Int
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Cardápio
// ------------------------------------------------------------------

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  icon         String     @default("🍔")
  order        Int        @default(0)
  products     Product[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@unique([restaurantId, slug])
}

model Addon {
  id           String         @id @default(cuid())
  restaurantId String
  name         String
  price        Float          @default(0)
  type         String         @default("EXTRA") // EXTRA | REMOVER | PONTO
  products     ProductAddon[]
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model ProductAddon {
  id        String @id @default(cuid())
  productId String
  addonId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  addon   Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([productId, addonId])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  restaurantId String
  slug         String
  description  String
  ingredients  String
  image        String
  price        Float
  promoPrice   Float?
  available    Boolean  @default(true)
  featured     Boolean  @default(false)
  categoryId   String
  soldCount    Int      @default(0)
  rating       Float    @default(4.8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  addons     ProductAddon[]
  orderItems OrderItem[]
  favorites  Favorite[]
  reviews    Review[]
  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, slug])
  @@index([categoryId])
  @@index([restaurantId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Cupons e Promoções
// ------------------------------------------------------------------

enum CouponType {
  PERCENTUAL
  VALOR
}

model Coupon {
  id               String     @id @default(cuid())
  restaurantId     String
  code             String
  type             CouponType
  value            Float
  maxUses          Int?
  usedCount        Int        @default(0)
  singleUsePerUser Boolean    @default(true)
  minOrderValue    Float      @default(0)
  expiresAt        DateTime
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())

  redemptions CouponRedemption[]
  orders      Order[]
  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?  @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Pedidos
// ------------------------------------------------------------------

enum OrderStatus {
  RECEBIDO
  ACEITO
  PREPARANDO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
  RECUSADO
}

enum PaymentMethod {
  PIX
  CARTAO
  DINHEIRO
}

enum PaymentStatus {
  PENDENTE
  PAGO
  FALHOU
}

enum DeliveryType {
  ENTREGA
  RETIRADA
}

model Order {
  id                String        @id @default(cuid())
  restaurantId      String
  number            Int
  userId            String
  addressId         String?
  status            OrderStatus   @default(RECEBIDO)
  deliveryType      DeliveryType  @default(ENTREGA)
  scheduledFor      DateTime?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDENTE)
  paymentExternalId String?
  pixQrCode         String?
  pixQrCodeBase64   String?
  changeFor         Float?
  subtotal          Float
  deliveryFee       Float         @default(0)
  discount          Float         @default(0)
  total             Float
  notes             String?
  couponId          String?
  entregadorId      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  acceptedAt        DateTime?
  deliveredAt       DateTime?

  user       User             @relation(fields: [userId], references: [id])
  address    Address?         @relation(fields: [addressId], references: [id])
  coupon     Coupon?          @relation(fields: [couponId], references: [id])
  entregador User?            @relation("EntregadorOrders", fields: [entregadorId], references: [id])
  items      OrderItem[]
  statusLog  OrderStatusLog[]
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, number])
  @@index([userId])
  @@index([status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  quantity     Int
  unitPrice    Float
  addonsLabel  String?
  removedLabel String?
  notes        String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  email        String
  phone        String?
  subject      String
  message      String
  read         Boolean    @default(false)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

model SiteVisit {
  id           String     @id @default(cuid())
  restaurantId String
  visitorHash  String
  path         String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([visitorHash])
  @@index([path, createdAt])
  @@index([restaurantId, createdAt])
}
